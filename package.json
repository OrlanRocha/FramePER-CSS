{
  "name": "frame-per",
  "version": "2.17.0",
  "description": "Frame PER - Modern UI Framework (CSS & JS)",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:sass": "sass src/scss/framePER.scss dist/framePER.css",
    "build:postcss": "postcss dist/framePER.css -o dist/framePER.min.css --config postcss.config.js",
    "build": "npm run build:sass && npm run build:postcss && npm run build:js-copy && npm run build:js",
    "build:js": "terser src/js/framePER.js -o dist/framePER.min.js -c -m --source-map \"url='framePER.min.js.map'\"",
    "build:js-copy": "node -e \"require('fs').copyFileSync('src/js/framePER.js', 'dist/framePER.js')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrlanRocha/FramePER-CSS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/OrlanRocha/FramePER-CSS/issues"
  },
  "homepage": "https://github.com/OrlanRocha/FramePER-CSS#readme",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "cssnano": "^8.0.10",
    "postcss": "^8.5.29",
    "postcss-cli": "^12.0.0",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "terser": "^5.51.2"
  }
}